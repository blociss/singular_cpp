proc balancingIdeal(labeledgraph G)
"USAGE:  balancingIdeal(G); G labeledgraph@*
ASSUME:  G is a labeled graph
RETURN:  ideal of balancing condition of the graph, basering is assumed to be G.over
KEYWORDS: Feynman graph
EXAMPLE:  example balancingIdeal; shows an example
"
{
  print("[DEBUG] Entering balancingIdeal");
  print("[DEBUG] Current ring:"+string(basering));
  print("[DEBUG] labelgraph:"+string(G));
  list v = G.vertices;
  print("[DEBUG] vertices:"+string(v));
  list e = G.edges;
  print("[DEBUG] edges:"+string(e));
  list lab = G.labels;
  print("[DEBUG] labels:"+string(lab));
  int i,j;
  ideal I;
  poly edg;
  poly rel;
  for (i = 1; i<=size(v); i++){
    edg=0;
    for (j = 1; j<=size(e); j++){
     if (size(e[j])==2){
       if (e[j][1]==v[i]){edg=edg+lab[j];}
       if (e[j][2]==v[i]){edg=edg-lab[j];}
     } else {
       if (e[j][1]==v[i]){edg=edg+lab[j];}
     }
    }
    I=I+ideal(edg);
  }
  for (j = 1; j<=size(e); j++){
   if (size(e[j])==1){
     rel=rel+lab[j];
   }
  }
  I=I,rel;
  return(I);
}
